+    def queue(self, event, props=None):
+        """Batch an event; sent once at exit so the CLI stays fast."""
+        if not getattr(self, "_queued", None):
+            self._queued = []
+            atexit.register(self.flush)
+        self._queued.append({"event": event, "props": dict(props or {}), "version": __version__})
+
+    def flush(self):
+        for payload in getattr(self, "_queued", []):
+            self._post(payload)
+        self._queued = []
+
